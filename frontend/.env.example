# Flutter does not load dotenv files automatically. Use this value with
# --dart-define=SHATRANJ_API_URL=... when starting or building the app.

SHATRANJ_API_URL=http://localhost:8080/api/v1

# Physical Android device example:
# SHATRANJ_API_URL=http://192.168.0.7:8080/api/v1

# Android emulator example:
# SHATRANJ_API_URL=http://10.0.2.2:8080/api/v1
